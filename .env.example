OPENROUTER_API_KEY=
# An OpenRouter model ID that supports tool calling, e.g. openai/gpt-4o-mini
LLM_MODEL=
EMBED_MODEL=baai/bge-m3
LECTURE_DURATION_MIN=15
SPEAKING_MIN=5
SPEAKING_WPM=115

# Voice (Gnani Timbre v2.5 TTS + Prisma STT). Needed for `render` and `session --voice/--mic`.
GNANI_API_KEY=
TTS_VOICE=Kaveri
TTS_LANGUAGE=en-IN
TTS_SPEED=0.85
STT_LANGUAGE=en-IN
# Each lecture picks its teaching language in Studio; its Gnani voice can be changed here, e.g. TTS_VOICE_TE_IN=Lavanya

# Script judge: Jev checks the generated script with yes/no questions (uses OPENROUTER_API_KEY).
JUDGE_ENABLED=true
JUDGE_MODEL=typesafe/jev-1.13

# Talking avatar in the classroom (free, runs in the browser). false = audio only, as before.
AVATAR_ENABLED=true
# Pictures in the material (photos, paintings, maps, diagrams, charts): described by a vision model at index time.
# The model must accept images; it defaults to LLM_MODEL.
VISION_ENABLED=true
# VISION_MODEL=anthropic/claude-haiku-5.5
# Interactive graphs ([VISUAL]) from the charts in the slides, built by a model and checked by code
VISUALS_ENABLED=true
# VISUAL_MODEL=anthropic/claude-sonnet-4.5   (defaults to LLM_MODEL; a stronger coding model draws better visuals)
# AVATAR_MODEL_URL=/assets/avatars/my-avatar.glb   (a GLB with Oculus visemes and/or ARKit blend shapes)
# Guardrails: Jev checks every student question before the AI sees it, and every answer before the student hears it
# (prompt injection, harmful requests, abuse, personal data; uses OPENROUTER_API_KEY).
GUARDRAILS_ENABLED=true
# Where programs run: auto (docker when the image is pulled, else the OS sandbox), docker, os, off. For docker, pull
# the image once: docker pull python:3.12-slim
ERIS_SANDBOX=auto
# ERIS_SANDBOX_IMAGE=python:3.12-slim
# The sign-in page offers the demo accounts made by `python main.py seed`. Set to false before real users sign in.
ERIS_DEMO_LOGINS=true
# On a server (deploy/README.md): your domain for automatic HTTPS (leave out to serve plain HTTP on the server's IP),
# and send the sign-in cookie over HTTPS only (true only when the site has HTTPS, or nobody can stay signed in).
# ERIS_DOMAIN=eris.example.com
ERIS_SECURE_COOKIES=false
# Students' doubts may get answers whose programs run on the server (in the sandbox). Off: code is explained in
# words and notes only. Teachers' previews can always run code.
ERIS_STUDENT_CODE_RUNS=false
# Anyone may create a teacher account on the sign-in page. Off: only students sign up (teachers come from the seed).
ERIS_TEACHER_SIGNUP=false
